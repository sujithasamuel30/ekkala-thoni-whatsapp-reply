# Copy this file to `.env` in the same folder and fill in the values.
# Never share this file — the access token is a secret.
# The server loads .env automatically on start.

# Meta WhatsApp Cloud API — from the Meta Business setup (see SETUP.md)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any secret string you choose; must match the verify token in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=ekkala-thoni-verify

# Server port (default 3000)
PORT=3000

# Template images folder (default is the saved templates folder)
# TEMPLATES_DIR=/home/hatch/workspace/your_files/whatsapp-auto-reply-templates

# faster-whisper model for voice transcription: tiny (default) | base | small
# WHISPER_MODEL=tiny

# DRY_RUN=1 means: classify + log, but do NOT send anything to Meta.
# The server turns DRY_RUN on automatically when the token/number ID is missing.
# DRY_RUN=1
